# Ключ OpenRouter для генерации текстов рекомендаций (https://openrouter.ai/keys)
# Без ключа приложение работает: помощник использует шаблонные формулировки.
OPENROUTER_API_KEY=

# Модель OpenRouter (любая доступная на openrouter.ai)
LLM_MODEL=openai/gpt-4o-mini

POSTGRES_USER=farmer
POSTGRES_PASSWORD=farmer
POSTGRES_DB=growth
JWT_SECRET=demo-secret-change-me
